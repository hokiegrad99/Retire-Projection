# Retire Projection — template environment file.
# Copy to `.env` (project root) and adjust. The real `.env` is gitignored.

# --- Local development database (native PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://retire_app:CHANGE_ME@127.0.0.1:5432/retirement

# --- Server binding: loopback only unless you deliberately expose the app ---
APP_HOST=127.0.0.1
APP_PORT=8000

# development | production
ENVIRONMENT=development

# Browser origins allowed by CORS (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO

# --- Used by docker-compose.yml (production deployment) ---
# CHANGE these before any network-exposed deployment. If the password contains
# URL-special characters (%, @, /, :), percent-encode it inside DATABASE_URL.
POSTGRES_USER=retire_app
POSTGRES_DB=retirement
POSTGRES_PASSWORD=CHANGE_ME
